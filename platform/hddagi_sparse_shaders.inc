static const char *SPARSE_COMMON_GLSL = R"GLSL(
// Shared sparse-brick definitions for the M2 GPU micro-tests.
//
// This file is concatenated ahead of each shader by build.sh, because Godot's
// shader preprocessor is the real include mechanism and glslang's #include
// support depends on the target environment. Keeping the text identical avoids
// the two paths diverging.
//
// Layout contract (must match hddagi_sparse_gpu_model.h byte for byte):
//   PageEntry  16 bytes: page_id, generation, state, reserved
//   BrickMeta  32 bytes: region_x, region_y, region_z, owner_cascade,
//                        generation, state, last_write_epoch, retired_epoch
// Vec3 is deliberately spelled as three scalars: std430 vec3 alignment rules are
// a common source of silent layout drift.

#define SB_INVALID_PAGE 0xFFFFFFFFu

#define SB_STATE_UNMAPPED 0u
#define SB_STATE_REQUESTED 1u
#define SB_STATE_ALLOCATED 2u
#define SB_STATE_INITIALIZING 3u
#define SB_STATE_COMMITTED 4u
#define SB_STATE_RETIRED 6u
#define SB_STATE_FREE 7u
#define SB_STATE_OVERFLOWED 8u

struct PageEntry {
	uint page_id;
	uint generation;
	uint state;
	uint reserved;
};

struct BrickMeta {
	int region_x;
	int region_y;
	int region_z;
	int owner_cascade;
	uint generation;
	uint state;
	uint last_write_epoch;
	uint retired_epoch;
};

// Floor division by the brick edge. Only exact multiples reach here in the engine,
// but the shader must agree with the CPU oracle for negative world coordinates.
int sb_floor_div8(int v) {
	return (v >= 0) ? (v >> 3) : -(((-v) + 7) >> 3);
}

// Wrapped storage coordinate: (local + position) & (grid - 1).
ivec3 sb_wrap(ivec3 local_cell, ivec3 position, ivec3 grid) {
	return (local_cell + position) & (grid - 1);
}

// World region of a local voxel. The cascade origin is position - grid/2.
ivec3 sb_world_region(ivec3 local_cell, ivec3 position, ivec3 grid) {
	ivec3 world = position + local_cell - grid / 2;
	return ivec3(sb_floor_div8(world.x), sb_floor_div8(world.y), sb_floor_div8(world.z));
}

// Dense virtual slot, x fastest.
uint sb_slot(ivec3 wrapped_cell, uint cascade, ivec3 brick_dims) {
	ivec3 b = wrapped_cell >> 3;
	return cascade * (uint(brick_dims.x) * uint(brick_dims.y) * uint(brick_dims.z)) +
			uint(b.x) + uint(b.y) * uint(brick_dims.x) + uint(b.z) * uint(brick_dims.x) * uint(brick_dims.y);
}

// Physical atlas texel for a page id and a local-in-brick coordinate.
ivec3 sb_atlas_texel(uint page_id, ivec3 local_in_brick, ivec2 page_slots_xy) {
	uint px = uint(page_slots_xy.x);
	uint py = uint(page_slots_xy.y);
	uint bx = page_id % px;
	uint by = (page_id / px) % py;
	uint bz = page_id / (px * py);
	return ivec3(int(bx) * 8 + local_in_brick.x,
			int(by) * 8 + local_in_brick.y,
			int(bz) * 8 + local_in_brick.z);
}

// Identity canary. Not the engine's E5B9G9R9 or rgbe packer; it exists so a swapped
// page or wrong voxel is obvious rather than merely different.
uint sb_canary(uint cascade, ivec3 region, ivec3 local_in_brick, uint generation) {
	return ((cascade & 7u) << 29) | ((uint(region.x) & 7u) << 26) | ((uint(region.y) & 7u) << 23) |
			((uint(region.z) & 7u) << 20) | ((uint(local_in_brick.x) & 7u) << 17) |
			((uint(local_in_brick.y) & 7u) << 14) | ((uint(local_in_brick.z) & 7u) << 11) |
			(generation & 0x7FFu);
}
)GLSL";

static const char *SPARSE_PROBE_GLSL = R"GLSL(
// M2.04 — translation parity against the CPU oracle fixtures.
//
// One invocation per fixture record. Recomputes wrapped coordinate, virtual slot,
// world region and atlas texel entirely in the shader and compares against the
// values the M1 oracle produced. Any disagreement sets parity_ok = 0 and is
// reported per record so the failing index is identifiable.
//
// The fixture buffer is uploaded verbatim from gpu/fixtures/probe_fixtures.bin,
// 80 bytes per record, all fields 4-byte aligned.


layout(local_size_x = 64) in;

struct ProbeFixture {
	uint cascade;
	int pos_x;
	int pos_y;
	int pos_z;
	int local_x;
	int local_y;
	int local_z;
	uint expected_slot;
	uint expected_wrapped_x;
	uint expected_wrapped_y;
	uint expected_wrapped_z;
	int expected_region_x;
	int expected_region_y;
	int expected_region_z;
	uint expected_texel_x;
	uint expected_texel_y;
	uint expected_texel_z;
	uint pad0;
	uint pad1;
	uint pad2;
};

struct ProbeResult {
	uint slot;
	uint wrapped_x;
	uint wrapped_y;
	uint wrapped_z;
	int region_x;
	int region_y;
	int region_z;
	uint texel_x;
	uint texel_y;
	uint texel_z;
	uint parity_ok;
	uint pad0;
};

layout(set = 0, binding = 0, std430) readonly buffer Fixtures { ProbeFixture records[]; } fixtures;
layout(set = 0, binding = 1, std430) writeonly buffer Results { ProbeResult records[]; } results;

layout(push_constant) uniform PC {
	uint count;
	uint grid_x;
	uint grid_y;
	uint grid_z;
	uint cascade_count;
	uint brick_dim_x;
	uint brick_dim_y;
	uint brick_dim_z;
	uint page_slots_x;
	uint page_slots_y;
} pc;

void main() {
	uint index = gl_GlobalInvocationID.x;
	if (index >= pc.count) {
		return;
	}

	ProbeFixture f = fixtures.records[index];

	ivec3 grid = ivec3(pc.grid_x, pc.grid_y, pc.grid_z);
	ivec3 position = ivec3(f.pos_x, f.pos_y, f.pos_z);
	ivec3 local_cell = ivec3(f.local_x, f.local_y, f.local_z);

	ivec3 wrapped = sb_wrap(local_cell, position, grid);
	ivec3 region = sb_world_region(local_cell, position, grid);
	uint slot = sb_slot(wrapped, f.cascade, ivec3(pc.brick_dim_x, pc.brick_dim_y, pc.brick_dim_z));
	ivec3 local_in_brick = wrapped & 7;
	ivec3 texel = sb_atlas_texel(slot, local_in_brick, ivec2(pc.page_slots_x, pc.page_slots_y));

	ProbeResult r;
	r.slot = slot;
	r.wrapped_x = uint(wrapped.x);
	r.wrapped_y = uint(wrapped.y);
	r.wrapped_z = uint(wrapped.z);
	r.region_x = region.x;
	r.region_y = region.y;
	r.region_z = region.z;
	r.texel_x = uint(texel.x);
	r.texel_y = uint(texel.y);
	r.texel_z = uint(texel.z);
	r.pad0 = 0u;

	bool ok = slot == f.expected_slot &&
			uint(wrapped.x) == f.expected_wrapped_x &&
			uint(wrapped.y) == f.expected_wrapped_y &&
			uint(wrapped.z) == f.expected_wrapped_z &&
			region.x == f.expected_region_x &&
			region.y == f.expected_region_y &&
			region.z == f.expected_region_z &&
			uint(texel.x) == f.expected_texel_x &&
			uint(texel.y) == f.expected_texel_y &&
			uint(texel.z) == f.expected_texel_z;
	r.parity_ok = ok ? 1u : 0u;

	results.records[index] = r;
}
)GLSL";

static const char *SPARSE_CANARY_WRITE_GLSL = R"GLSL(
// M2.05, write half — fill the physical atlas with a unique, addressable pattern.
//
// The encoding is a bijection, not a hash: value = (page << 9) | local_index.
// Any two distinct (page, local) pairs therefore produce distinct values, so a
// mis-addressed write is visible as a wrong value rather than as noise.
//
// The read half is canary_check.comp. Decode parity against the engine's
// E5B9G9R9 shared view cannot be established without a GPU and is out of scope
// for this file; it is tracked in artifacts/m2_scaffold.md.


layout(local_size_x = 64) in;

layout(set = 0, binding = 0, r32ui) uniform uimage3D atlas;

layout(push_constant) uniform PC {
	uint page_count;
	uint page_slots_x;
	uint page_slots_y;
	uint offset;
} pc;

void main() {
	uint index = pc.offset + gl_GlobalInvocationID.x;
	uint total = pc.page_count * 512u;
	if (index >= total) {
		return;
	}

	uint page = index / 512u;
	uint local_index = index % 512u;
	ivec3 local_in_brick = ivec3(int(local_index & 7u), int((local_index >> 3) & 7u), int((local_index >> 6) & 7u));
	ivec3 texel = sb_atlas_texel(page, local_in_brick, ivec2(pc.page_slots_x, pc.page_slots_y));

	uint value = (page << 9) | local_index;
	imageStore(atlas, texel, uvec4(value));
}
)GLSL";

static const char *SPARSE_CANARY_CHECK_GLSL = R"GLSL(
// M2.05, read half — verify every atlas texel still holds its own pattern.
//
// A single mismatched texel increments the atomic counter, so the host only has
// to read one word to know whether the atlas addressing is correct. The first
// failing index is also recorded for diagnosis.


layout(local_size_x = 64) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage3D atlas;
layout(set = 0, binding = 1, std430) buffer CheckResult {
	uint mismatches;
	uint first_bad_page;
	uint first_bad_local;
	uint pad;
} result;

layout(push_constant) uniform PC {
	uint page_count;
	uint page_slots_x;
	uint page_slots_y;
	uint offset;
} pc;

void main() {
	uint index = pc.offset + gl_GlobalInvocationID.x;
	uint total = pc.page_count * 512u;
	if (index >= total) {
		return;
	}

	uint page = index / 512u;
	uint local_index = index % 512u;
	ivec3 local_in_brick = ivec3(int(local_index & 7u), int((local_index >> 3) & 7u), int((local_index >> 6) & 7u));
	ivec3 texel = sb_atlas_texel(page, local_in_brick, ivec2(pc.page_slots_x, pc.page_slots_y));

	// Written unconditionally by the first invocation so a kernel that never ran
	// cannot be mistaken for a clean result.
	if (index == 0u) {
		result.pad = 1u;
	}

	uint expected = (page << 9) | local_index;
	uint actual = imageLoad(atlas, texel).r;

	if (actual != expected) {
		uint slot = atomicAdd(result.mismatches, 1u);
		if (slot == 0u) {
			result.first_bad_page = page;
			result.first_bad_local = local_index;
		}
	}
}
)GLSL";

static const char *SPARSE_MANAGE_GLSL = R"GLSL(
// M2.03 — request compaction, allocation and initialisation, GPU-shaped.
//
// Three modes share one dispatch layout so the host can issue them back to back
// without rebinding:
//   MODE_COMPACT      build a compacted list of requested virtual slots
//   MODE_ALLOCATE     hand out physical pages from the free list
//   MODE_INITIALIZE   promote ALLOCATED pages to COMMITTED after zeroing
//
// Allocation order is deliberately atomic and therefore NOT deterministic across
// runs. Translation (the probe shader) is deterministic and is what fixtures pin;
// allocation is validated by invariants instead, which is why the M1 oracle cannot
// be compared page-for-page with this path.


layout(local_size_x = 64) in;

#define MODE_COMPACT 0u
#define MODE_ALLOCATE 1u
#define MODE_INITIALIZE 2u

layout(set = 0, binding = 0, std430) buffer PageTable { PageEntry entries[]; } table;
layout(set = 0, binding = 1, std430) buffer Meta { BrickMeta meta[]; } metadata;
layout(set = 0, binding = 2, std430) readonly buffer FreeList { uint pages[]; } free_list;
layout(set = 0, binding = 3, std430) buffer FreeCursor { uint value; } free_cursor;
layout(set = 0, binding = 4, std430) readonly buffer RequestBits { uint words[]; } requests;
layout(set = 0, binding = 5, std430) buffer Compacted { uint slots[]; } compacted;
layout(set = 0, binding = 6, std430) buffer Counters {
	uint requested;
	uint compacted_count;
	uint allocated;
	uint overflow;
	uint committed;
	uint pad0;
	uint pad1;
	uint pad2;
} counters;
layout(set = 0, binding = 7, std430) buffer AllocatedSlots { uint slots[]; } allocated_slots;

layout(push_constant) uniform PC {
	uint mode;
	uint word_count;
	uint slot_count;
	uint capacity;
	uint epoch;
	uint generation_base;
	uint bricks_per_cascade;
	uint brick_dim_x;
	uint brick_dim_y;
	uint brick_dim_z;
} pc;

// One invocation per 32-bit request word. Order within a word is stable; order
// between words is not, because the destination index comes from an atomic.
void compact_requests(uint word_index) {
	uint word = requests.words[word_index];
	uint base = word_index * 32u;
	while (word != 0u) {
		int bit = findLSB(word);
		uint slot = base + uint(bit);
		if (slot < pc.slot_count) {
			uint index = atomicAdd(counters.compacted_count, 1u);
			compacted.slots[index] = slot;
		}
		word &= word - 1u;
	}
}

void allocate_one(uint index) {
	uint slot = compacted.slots[index];
	uint cursor = atomicAdd(free_cursor.value, 1u);
	if (cursor >= pc.capacity) {
		// A full pool is a controlled state: record it, mark the slot, and never
		// hand out a page that is already owned.
		atomicAdd(counters.overflow, 1u);
		table.entries[slot].state = SB_STATE_OVERFLOWED;
		return;
	}

	uint page = free_list.pages[cursor];
	uint generation = pc.generation_base + index;

	table.entries[slot].page_id = page;
	table.entries[slot].generation = generation;
	table.entries[slot].state = SB_STATE_ALLOCATED;

	metadata.meta[page].generation = generation;
	metadata.meta[page].state = SB_STATE_ALLOCATED;
	metadata.meta[page].last_write_epoch = pc.epoch;
	metadata.meta[page].retired_epoch = 0u;

	allocated_slots.slots[cursor] = slot;
	atomicAdd(counters.allocated, 1u);
}

// Runs after the host has zeroed the page. INITIALIZING is the only path to
// COMMITTED, so no reader can observe an uninitialised page.
void initialize_one(uint cursor) {
	uint slot = allocated_slots.slots[cursor];
	uint page = table.entries[slot].page_id;
	if (page == SB_INVALID_PAGE) {
		return;
	}
	table.entries[slot].state = SB_STATE_COMMITTED;
	metadata.meta[page].state = SB_STATE_COMMITTED;
	metadata.meta[page].last_write_epoch = pc.epoch;
	atomicAdd(counters.committed, 1u);
}

void main() {
	uint index = gl_GlobalInvocationID.x;

	if (pc.mode == MODE_COMPACT) {
		if (index < pc.word_count) {
			compact_requests(index);
		}
	} else if (pc.mode == MODE_ALLOCATE) {
		if (index < counters.compacted_count) {
			allocate_one(index);
		}
	} else if (pc.mode == MODE_INITIALIZE) {
		if (index < counters.allocated) {
			initialize_one(index);
		}
	}
}
)GLSL";
