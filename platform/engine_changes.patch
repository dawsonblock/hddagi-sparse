+// One invocation per 32-bit request word. Order within a word is stable; order
+// between words is not, because the destination index comes from an atomic.
+void compact_requests(uint word_index) {
+	uint word = requests.words[word_index];
+	uint base = word_index * 32u;
+	while (word != 0u) {
+		int bit = findLSB(word);
+		uint slot = base + uint(bit);
+		if (slot < pc.slot_count) {
+			uint index = atomicAdd(counters.compacted_count, 1u);
+			compacted.slots[index] = slot;
+		}
+		word &= word - 1u;
+	}
