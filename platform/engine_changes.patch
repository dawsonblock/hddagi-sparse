+// M2.01 / M2.04 decision core, free of RenderingDevice dependencies.
+//
+// The engine side of sparse bricks splits cleanly in two:
+//
+//   1. decide whether this device can support the mode, and at what capacity;
+//   2. decide how many workgroups to dispatch and what push constants to send.
+//
+// Both are pure arithmetic over numbers the adapter reads from RenderingDevice.
+// Keeping them here means they can be compiled and tested on a host with no GPU,
+// and the Windows integration only has to supply the numbers and bind the RIDs.
+//
+// This file does not include rendering_device.h on purpose. The adapter that
+// fills DeviceCaps lives in RD_ADAPTER.md.
+
+#pragma once
+
+#include <cstdint>
+
+namespace hddagi_sparse {
+
+constexpr int BRICK_EDGE = 8;
+constexpr uint32_t VOXELS_PER_BRICK = 512;
+constexpr uint32_t WORKGROUP_SIZE = 64;
+
+// Byte sizes of the records the shaders consume. Kept in sync with
+// gpu/hddagi_sparse_gpu_model.h by static_assert there and by test here.
+constexpr uint32_t PAGE_ENTRY_BYTES = 16;
+constexpr uint32_t BRICK_META_BYTES = 32;
+constexpr uint32_t COUNTERS_BYTES = 32;
+constexpr uint32_t CHECK_RESULT_BYTES = 16;
+
+// What the adapter must discover before sparse mode can be considered.
+//
+// Format/usage support cannot be queried directly in this RenderingDevice API.
+// The adapter probes each one by creating a 1x1x1 texture with the exact format
+// and usage, checking texture_is_valid(), and freeing it. These fields are the
+// results of those probes, not assumptions.
+struct DeviceCaps {
+	uint64_t max_texture_size_3d = 0;
+	uint64_t max_storage_buffers_per_set = 0;
+	uint64_t max_storage_images_per_set = 0;
+	uint64_t max_push_constant_size = 0;
+	uint64_t max_compute_workgroups_x = 0;
+
+	bool r32_uint_3d_storage = false;
+	bool r8_uint_3d_storage = false;
+	bool e5b9g9r9_shareable_view = false;
+	bool storage_buffer = false;
+};
+
+struct SparseRequest {
+	int cascade_count = 6;
+	int grid[3] = { 128, 64, 128 };
+	uint32_t requested_pages = 1024;
+};
+
+enum class Decision : uint32_t {
+	SUPPORTED = 0,
+	REDUCED_CAPACITY = 1,
+	REFUSED = 2,
+};
+
+// Check ids match the capability table in artifacts/m2_scaffold.md.
+enum class Check : uint32_t {
+	NONE = 0,
+	LIGHT_FORMAT = 1,
+	DISOCLUSION_FORMAT = 2,
+	SHARED_LIGHT_VIEW = 3,
+	ATLAS_EXTENT = 4,
+	STORAGE_BUFFER = 5,
+	PUSH_CONSTANTS = 6,
+	DESCRIPTOR_BUDGET = 7,
+};
+
+struct SparsePlan {
+	Decision decision = Decision::REFUSED;
+	Check failed_check = Check::NONE;
+	const char *reason = "";
+
+	uint32_t virtual_pages = 0;
+	uint32_t capacity = 0; // pages actually allocated after any reduction
+	int page_slots[3] = { 0, 0, 0 };
+	int atlas_texels[3] = { 0, 0, 0 };
+
+	uint64_t light_atlas_bytes = 0;
+	uint64_t neighbour_atlas_bytes = 0;
+	uint64_t disocclusion_atlas_bytes = 0;
+	uint64_t page_table_bytes = 0;
+	uint64_t meta_bytes = 0;
+	uint64_t request_bitset_bytes = 0;
+	uint64_t compacted_bytes = 0;
+	uint64_t free_list_bytes = 0;
+	uint64_t total_bytes = 0;
+};
+
+// Largest page-slot factorisation whose product is >= capacity and whose axes
+// stay within max_slots. Returns false when not even one page fits.
+bool factorise_slots(uint32_t capacity, uint32_t max_slots, int out[3]);
+
+// Maximum number of pages that can be addressed given an axis limit.
+uint32_t max_pages_for_slots(uint32_t max_slots);
+
+SparsePlan plan_sparse_resources(const DeviceCaps &caps, const SparseRequest &request);
+
+// ---------------------------------------------------------------------------
+// Dispatch planning (M2.04)
+// ---------------------------------------------------------------------------
+
+// Push constant blocks, laid out exactly as the shaders declare them.
+struct ProbePushConstants {
+	uint32_t count;
+	uint32_t grid_x;
+	uint32_t grid_y;
+	uint32_t grid_z;
+	uint32_t cascade_count;
+	uint32_t brick_dim_x;
+	uint32_t brick_dim_y;
+	uint32_t brick_dim_z;
+	uint32_t page_slots_x;
+	uint32_t page_slots_y;
+};
+
+struct ManagePushConstants {
+	uint32_t mode;
+	uint32_t word_count;
+	uint32_t slot_count;
+	uint32_t capacity;
+	uint32_t epoch;
+	uint32_t generation_base;
+	uint32_t bricks_per_cascade;
+	uint32_t brick_dim_x;
+	uint32_t brick_dim_y;
+	uint32_t brick_dim_z;
+};
+
+struct CanaryPushConstants {
+	uint32_t page_count;
+	uint32_t page_slots_x;
+	uint32_t page_slots_y;
+	uint32_t offset; // first linear index for this pass; lets a large pool be split
+};
+
+static_assert(sizeof(ProbePushConstants) == 40, "probe push constants must be 40 bytes");
+static_assert(sizeof(ManagePushConstants) == 40, "manage push constants must be 40 bytes");
+static_assert(sizeof(CanaryPushConstants) == 16, "canary push constants must be 16 bytes");
+
+enum : uint32_t {
+	MODE_COMPACT = 0,
+	MODE_ALLOCATE = 1,
+	MODE_INITIALIZE = 2,
+};
+
+struct DispatchPlan {
+	uint32_t probe_groups = 0;
+	uint32_t compact_groups = 0;
+	uint32_t allocate_groups = 0;
+	uint32_t initialize_groups = 0;
+
+	// The canary pass scales with capacity * 512, so it can exceed the device's
+	// workgroup-count limit. The host issues `canary_passes` dispatches of at most
+	// `canary_groups` groups each, advancing `canary.offset` by groups * 64.
+	uint32_t canary_total_groups = 0;
+	uint32_t canary_groups = 0;
+	uint32_t canary_passes = 0;
+
+	ProbePushConstants probe{};
+	ManagePushConstants compact{};
+	ManagePushConstants allocate{};
+	ManagePushConstants initialize{};
+	CanaryPushConstants canary{};
+};
+
+inline uint32_t groups_for(uint32_t items) {
+	return (items + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE;
+}
+
+DispatchPlan plan_dispatch(const SparsePlan &plan, uint32_t fixture_count,
+		uint32_t epoch, uint32_t generation_base, int cascade_count, const int grid[3],
+		uint32_t max_workgroups_x = 65535);
+
+} // namespace hddagi_sparse
--- a/servers/rendering/renderer_rd/environment/hddagi_sparse_plan.cpp	2026-11-07 21:07:49
+++ b/servers/rendering/renderer_rd/environment/hddagi_sparse_plan.cpp
@@ -0,0 +1,245 @@
+#include "hddagi_sparse_plan.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace hddagi_sparse {
+
+uint32_t max_pages_for_slots(uint32_t max_slots) {
+	// Three axes of page slots, each axis limited by the 3D extent.
+	const uint64_t v = uint64_t(max_slots) * uint64_t(max_slots) * uint64_t(max_slots);
+	return v > 0xFFFFFFFFull ? 0xFFFFFFFFu : uint32_t(v);
+}
+
+bool factorise_slots(uint32_t capacity, uint32_t max_slots, int out[3]) {
+	if (capacity == 0 || max_slots == 0) {
+		return false;
+	}
+	if (uint64_t(capacity) > uint64_t(max_slots) * max_slots * max_slots) {
+		return false;
+	}
+
+	// Prefer a near-cubic split: it minimises the longest axis, which is what
+	// texture extent limits constrain first. The search is bounded around the cube
+	// root because a very lopsided split wastes slots for no benefit, and an
+	// unbounded scan would be O(max_slots^2) at startup.
+	uint32_t best_slots = 0;
+	int best[3] = { 0, 0, 0 };
+
+	const double cube_root = std::cbrt(double(capacity));
+	uint32_t limit = uint32_t(cube_root * 2.0) + 2;
+	if (limit < 4) {
+		limit = 4;
+	}
+	if (limit > max_slots) {
+		limit = max_slots;
+	}
+
+	for (uint32_t px = 1; px <= limit; px++) {
+		const uint32_t remaining = (capacity + px - 1) / px;
+		if (remaining == 0) {
+			break;
+		}
+		for (uint32_t py = 1; py <= limit; py++) {
+			const uint32_t pz = (remaining + py - 1) / py;
+			if (pz > max_slots) {
+				continue;
+			}
+			const uint32_t slots = px * py * pz;
+			if (slots < capacity) {
+				continue;
+			}
+			// Fewer slots wins. On a tie, prefer the shorter longest axis (the 3D
+			// extent limit constrains that first), then the larger shortest axis,
+			// which rejects lopsided splits such as 4x16x16 in favour of 8x8x16.
+			const int longest = int(std::max(px, std::max(py, pz)));
+			const int shortest = int(std::min(px, std::min(py, pz)));
+			const int best_longest = std::max(best[0], std::max(best[1], best[2]));
+			const int best_shortest = std::min(best[0], std::min(best[1], best[2]));
+			const bool better = best_slots == 0 || slots < best_slots ||
+					(slots == best_slots && (longest < best_longest ||
+							(longest == best_longest && shortest > best_shortest)));
+			if (better) {
+				best_slots = slots;
+				best[0] = int(px);
+				best[1] = int(py);
+				best[2] = int(pz);
+			}
+		}
+	}
+
+	if (best_slots == 0) {
+		return false;
+	}
+	out[0] = best[0];
+	out[1] = best[1];
+	out[2] = best[2];
+	return true;
+}
+
+SparsePlan plan_sparse_resources(const DeviceCaps &caps, const SparseRequest &request) {
+	SparsePlan plan;
+	plan.virtual_pages = uint32_t(request.cascade_count) *
+			uint32_t((request.grid[0] / BRICK_EDGE) * (request.grid[1] / BRICK_EDGE) * (request.grid[2] / BRICK_EDGE));
+
+	// Checks 1-3: the three formats and the shared view. A device that cannot do
+	// all three cannot host the payload group at all, so there is no partial mode.
+	if (!caps.r32_uint_3d_storage) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::LIGHT_FORMAT;
+		plan.reason = "3D R32_UINT storage image unsupported";
+		return plan;
+	}
+	if (!caps.r8_uint_3d_storage) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::DISOCLUSION_FORMAT;
+		plan.reason = "3D R8_UINT storage image unsupported";
+		return plan;
+	}
+	if (!caps.e5b9g9r9_shareable_view) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::SHARED_LIGHT_VIEW;
+		plan.reason = "E5B9G9R9 shared sampled view unsupported; decode parity would be unprovable";
+		return plan;
+	}
+	if (!caps.storage_buffer) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::STORAGE_BUFFER;
+		plan.reason = "storage buffers unsupported";
+		return plan;
+	}
+
+	// Check 4: atlas extent. Reduce capacity rather than refuse, because a smaller
+	// pool is still correct; the RFC requires the reduction to be recorded.
+	if (caps.max_texture_size_3d < BRICK_EDGE) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::ATLAS_EXTENT;
+		plan.reason = "3D texture extent smaller than one brick";
+		return plan;
+	}
+	const uint32_t max_slots = uint32_t(caps.max_texture_size_3d / BRICK_EDGE);
+	const uint32_t max_pages = max_pages_for_slots(max_slots);
+
+	uint32_t capacity = request.requested_pages;
+	bool reduced = false;
+	if (capacity == 0) {
+		capacity = 1;
+	}
+	if (capacity > max_pages) {
+		capacity = max_pages;
+		reduced = true;
+	}
+
+	int slots[3] = { 0, 0, 0 };
+	if (!factorise_slots(capacity, max_slots, slots)) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::ATLAS_EXTENT;
+		plan.reason = "no page-slot factorisation fits the 3D extent limit";
+		return plan;
+	}
+
+	// Check 6: the manage shader's push constant block.
+	if (caps.max_push_constant_size < sizeof(ManagePushConstants)) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::PUSH_CONSTANTS;
+		plan.reason = "push constant limit below the manage block size";
+		return plan;
+	}
+
+	// Check 7: the manage shader binds eight storage buffers in set 0.
+	if (caps.max_storage_buffers_per_set < 8) {
+		plan.decision = Decision::REFUSED;
+		plan.failed_check = Check::DESCRIPTOR_BUDGET;
+		plan.reason = "fewer than eight storage buffers per set";
+		return plan;
+	}
+
+	const uint32_t slots_total = uint32_t(slots[0]) * uint32_t(slots[1]) * uint32_t(slots[2]);
+
+	plan.capacity = capacity;
+	plan.page_slots[0] = slots[0];
+	plan.page_slots[1] = slots[1];
+	plan.page_slots[2] = slots[2];
+	plan.atlas_texels[0] = slots[0] * BRICK_EDGE;
+	plan.atlas_texels[1] = slots[1] * BRICK_EDGE;
+	plan.atlas_texels[2] = slots[2] * BRICK_EDGE;
+
+	// Atlas cost is driven by allocated slots, not by requested pages: the slack
+	// from rounding up to whole page slots is real memory.
+	plan.light_atlas_bytes = uint64_t(slots_total) * VOXELS_PER_BRICK * 4ull;
+	plan.neighbour_atlas_bytes = uint64_t(slots_total) * VOXELS_PER_BRICK * 4ull;
+	plan.disocclusion_atlas_bytes = uint64_t(slots_total) * VOXELS_PER_BRICK * 1ull;
+
+	plan.page_table_bytes = uint64_t(plan.virtual_pages) * PAGE_ENTRY_BYTES;
+	plan.meta_bytes = uint64_t(capacity) * BRICK_META_BYTES;
+	plan.request_bitset_bytes = (uint64_t(plan.virtual_pages) + 7) / 8;
+	plan.compacted_bytes = uint64_t(capacity) * 4;
+	plan.free_list_bytes = uint64_t(capacity) * 4;
+
+	plan.total_bytes = plan.light_atlas_bytes + plan.neighbour_atlas_bytes +
+			plan.disocclusion_atlas_bytes + plan.page_table_bytes + plan.meta_bytes +
+			plan.request_bitset_bytes + plan.compacted_bytes + plan.free_list_bytes +
+			COUNTERS_BYTES;
+
+	if (reduced) {
+		plan.decision = Decision::REDUCED_CAPACITY;
+		plan.reason = "requested page count exceeds what the 3D extent limit can address";
+	} else {
+		plan.decision = Decision::SUPPORTED;
+		plan.reason = "all capability checks passed";
+	}
+	return plan;
+}
+
+DispatchPlan plan_dispatch(const SparsePlan &plan, uint32_t fixture_count,
+		uint32_t epoch, uint32_t generation_base, int cascade_count, const int grid[3],
+		uint32_t max_workgroups_x) {
+	DispatchPlan d;
+
+	d.probe_groups = groups_for(fixture_count);
+	d.probe.count = fixture_count;
+	d.probe.grid_x = uint32_t(grid[0]);
+	d.probe.grid_y = uint32_t(grid[1]);
+	d.probe.grid_z = uint32_t(grid[2]);
+	d.probe.cascade_count = uint32_t(cascade_count);
+	d.probe.brick_dim_x = uint32_t(grid[0] / BRICK_EDGE);
+	d.probe.brick_dim_y = uint32_t(grid[1] / BRICK_EDGE);
+	d.probe.brick_dim_z = uint32_t(grid[2] / BRICK_EDGE);
+	d.probe.page_slots_x = uint32_t(plan.page_slots[0]);
+	d.probe.page_slots_y = uint32_t(plan.page_slots[1]);
+
+	const uint32_t word_count = (plan.virtual_pages + 31) / 32;
+	const uint32_t bricks_per_cascade = uint32_t((grid[0] / BRICK_EDGE) * (grid[1] / BRICK_EDGE) * (grid[2] / BRICK_EDGE));
+
+	d.compact_groups = groups_for(word_count);
+	// Allocate must cover the compacted list, which is bounded by the virtual slot
+	// count, not by capacity. Dispatching only `capacity` threads silently ignores
+	// every request beyond the pool size, so overflow is never counted and the host
+	// never learns the pool is too small. The shader guards the tail.
+	d.allocate_groups = groups_for(plan.virtual_pages);
+	d.initialize_groups = groups_for(plan.capacity);
+	d.canary_total_groups = groups_for(plan.capacity * VOXELS_PER_BRICK);
+	const uint32_t limit = max_workgroups_x == 0 ? 1u : max_workgroups_x;
+	d.canary_groups = d.canary_total_groups < limit ? d.canary_total_groups : limit;
+	d.canary_passes = d.canary_total_groups == 0 ? 0u : (d.canary_total_groups + limit - 1) / limit;
+
+	const uint32_t common[10] = { 0, word_count, plan.virtual_pages, plan.capacity, epoch,
+		generation_base, bricks_per_cascade, uint32_t(grid[0] / BRICK_EDGE),
+		uint32_t(grid[1] / BRICK_EDGE), uint32_t(grid[2] / BRICK_EDGE) };
+
+	d.compact = ManagePushConstants{ MODE_COMPACT, common[1], common[2], common[3], common[4],
+		common[5], common[6], common[7], common[8], common[9] };
+	d.allocate = ManagePushConstants{ MODE_ALLOCATE, common[1], common[2], common[3], common[4],
+		common[5], common[6], common[7], common[8], common[9] };
+	d.initialize = ManagePushConstants{ MODE_INITIALIZE, common[1], common[2], common[3], common[4],
+		common[5], common[6], common[7], common[8], common[9] };
+
+	d.canary.page_count = plan.capacity;
+	d.canary.page_slots_x = uint32_t(plan.page_slots[0]);
+	d.canary.page_slots_y = uint32_t(plan.page_slots[1]);
+	d.canary.offset = 0; // the host advances this per pass
+
+	return d;
+}
+
+} // namespace hddagi_sparse
--- a/servers/rendering/renderer_rd/environment/hddagi_sparse_selftest.h	2026-11-07 21:07:49
+++ b/servers/rendering/renderer_rd/environment/hddagi_sparse_selftest.h
@@ -0,0 +1,44 @@
+// In-engine self-test for the sparse-brick GPU path (M2.02 - M2.05).
+//
+// Creates the physical atlas, the page table and the auxiliary buffers, runs the
+// four kernels against CPU-generated fixtures, and reports pass/fail. It does not
+// touch GI rendering: the point is to prove the resources and the kernels work
+// inside RenderingDevice before anything depends on them.
+//
+// This file is copied into servers/rendering/renderer_rd/environment/ by
+// platform/install_engine_changes.sh.
+
+#pragma once
+
+#include "core/math/vector3i.h"
+#include "core/string/ustring.h"
+#include "servers/rendering/rendering_device.h"
+
+namespace hddagi_sparse {
+
+struct SelfTestResult {
+	bool ran = false;
+	bool passed = false;
+
+	int probe_records = 0;
+	int probe_mismatches = 0;
+	int probe_first_bad = -1;
+
+	int canary_texels = 0;
+	int canary_mismatches = 0;
+
+	bool allocator_ok = false;
+	uint32_t allocator_compacted = 0;
+	uint32_t allocator_allocated = 0;
+	uint32_t allocator_overflow = 0;
+	uint32_t allocator_committed = 0;
+	uint32_t allocator_duplicate_pages = 0;
+
+	String error;
+};
+
+// p_fixture_path is a res:// or absolute path to probe_fixtures.bin (80-byte records).
+SelfTestResult run_self_test(RD *p_rd, const String &p_fixture_path, uint32_t p_pages,
+		int p_cascades, const Vector3i &p_grid);
+
+} // namespace hddagi_sparse
--- a/servers/rendering/renderer_rd/environment/hddagi_sparse_selftest.cpp	2026-11-07 21:07:49
+++ b/servers/rendering/renderer_rd/environment/hddagi_sparse_selftest.cpp
@@ -0,0 +1,377 @@
+#include "hddagi_sparse_selftest.h"
+
+#include "core/io/file_access.h"
+#include "hddagi_sparse_plan.h"
+#include "hddagi_sparse_shaders.inc"
+
+#include <cstring>
+
+namespace hddagi_sparse {
+
+namespace {
+
+constexpr uint32_t FIXTURE_RECORD_BYTES = 80;
+constexpr uint32_t PROBE_RESULT_BYTES = 48;
+
+RID compile_compute(RD *p_rd, const char *p_body, String *r_error) {
+	String source = "#version 450\n";
+	source += String(SPARSE_COMMON_GLSL);
+	source += String(p_body);
+
+	String error;
+	Vector<uint8_t> spirv = p_rd->shader_compile_spirv_from_source(
+			RD::SHADER_STAGE_COMPUTE, source, RD::SHADER_LANGUAGE_GLSL, &error);
+	if (spirv.is_empty()) {
+		*r_error = "shader compile failed: " + error;
+		return RID();
+	}
+
+	Vector<RD::ShaderStageSPIRVData> stages;
+	RD::ShaderStageSPIRVData stage;
+	stage.shader_stage = RD::SHADER_STAGE_COMPUTE;
+	stage.spirv = spirv;
+	stages.push_back(stage);
+	return p_rd->shader_create_from_spirv(stages);
+}
+
+void free_if_valid(RD *p_rd, RID p_rid) {
+	if (p_rid.is_valid() && p_rd->uniform_set_is_valid(p_rid)) {
+		p_rd->free_rid(p_rid);
+		return;
+	}
+	if (p_rid.is_valid()) {
+		p_rd->free_rid(p_rid);
+	}
+}
+
+} // namespace
+
+SelfTestResult run_self_test(RD *p_rd, const String &p_fixture_path, uint32_t p_pages,
+		int p_cascades, const Vector3i &p_grid) {
+	SelfTestResult result;
+
+	// --- compile ------------------------------------------------------------
+	String error;
+	RID probe_shader = compile_compute(p_rd, SPARSE_PROBE_GLSL, &error);
+	if (probe_shader.is_null()) {
+		result.error = error;
+		return result;
+	}
+	RID canary_write_shader = compile_compute(p_rd, SPARSE_CANARY_WRITE_GLSL, &error);
+	RID canary_check_shader = compile_compute(p_rd, SPARSE_CANARY_CHECK_GLSL, &error);
+	RID manage_shader = compile_compute(p_rd, SPARSE_MANAGE_GLSL, &error);
+	if (canary_write_shader.is_null() || canary_check_shader.is_null() || manage_shader.is_null()) {
+		result.error = error;
+		p_rd->free_rid(probe_shader);
+		return result;
+	}
+
+	RID probe_pipeline = p_rd->compute_pipeline_create(probe_shader);
+	RID canary_write_pipeline = p_rd->compute_pipeline_create(canary_write_shader);
+	RID canary_check_pipeline = p_rd->compute_pipeline_create(canary_check_shader);
+	RID manage_pipeline = p_rd->compute_pipeline_create(manage_shader);
+	if (probe_pipeline.is_null() || canary_write_pipeline.is_null() ||
+			canary_check_pipeline.is_null() || manage_pipeline.is_null()) {
+		result.error = "compute pipeline creation failed";
+		return result;
+	}
+
+	// --- probe: translation parity against the CPU oracle -------------------
+	{
+		Error ferr = OK;
+		Vector<uint8_t> fixtures = FileAccess::get_file_as_bytes(p_fixture_path, &ferr);
+		if (fixtures.is_empty()) {
+			result.error = vformat("fixture file unreadable: %s (err %d)", p_fixture_path, int(ferr));
+		} else {
+			const uint32_t count = uint32_t(fixtures.size()) / FIXTURE_RECORD_BYTES;
+			result.probe_records = int(count);
+
+			RID fixture_buf = p_rd->storage_buffer_create(uint32_t(fixtures.size()), fixtures);
+			Vector<uint8_t> zero_results;
+			zero_results.resize(count * PROBE_RESULT_BYTES);
+			RID result_buf = p_rd->storage_buffer_create(uint32_t(zero_results.size()), zero_results);
+
+			Vector<RD::Uniform> uniforms;
+			uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_STORAGE_BUFFER, 0, fixture_buf));
+			uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_STORAGE_BUFFER, 1, result_buf));
+			RID uniform_set = p_rd->uniform_set_create(uniforms, probe_shader, 0);
+
+			ProbePushConstants pc{};
+			pc.count = count;
+			pc.grid_x = uint32_t(p_grid.x);
+			pc.grid_y = uint32_t(p_grid.y);
+			pc.grid_z = uint32_t(p_grid.z);
+			pc.cascade_count = uint32_t(p_cascades);
+			pc.brick_dim_x = uint32_t(p_grid.x / BRICK_EDGE);
+			pc.brick_dim_y = uint32_t(p_grid.y / BRICK_EDGE);
+			pc.brick_dim_z = uint32_t(p_grid.z / BRICK_EDGE);
+			pc.page_slots_x = 8;
+			pc.page_slots_y = 8;
+
+			RD::ComputeListID cl = p_rd->compute_list_begin();
+			p_rd->compute_list_bind_compute_pipeline(cl, probe_pipeline);
+			p_rd->compute_list_bind_uniform_set(cl, uniform_set, 0);
+			p_rd->compute_list_set_push_constant(cl, &pc, sizeof(pc));
+			p_rd->compute_list_dispatch(cl, groups_for(count), 1, 1);
+			p_rd->compute_list_end();
+
+			Vector<uint8_t> out = p_rd->buffer_get_data(result_buf);
+			if (out.size() >= count * PROBE_RESULT_BYTES) {
+				for (uint32_t i = 0; i < count; i++) {
+					uint32_t parity = 0;
+					memcpy(&parity, out.ptr() + i * PROBE_RESULT_BYTES + 40, 4);
+					if (parity != 1) {
+						result.probe_mismatches++;
+						if (result.probe_first_bad < 0) {
+							result.probe_first_bad = int(i);
+						}
+					}
+				}
+			} else {
+				result.error = "probe readback short";
+			}
+
+			p_rd->free_rid(uniform_set);
+			p_rd->free_rid(fixture_buf);
+			p_rd->free_rid(result_buf);
+		}
+	}
+
+	// --- canary: atlas addressing on a real 3D texture ----------------------
+	{
+		const uint32_t slots_x = 8, slots_y = 8, slots_z = 16;
+		RD::TextureFormat tf;
+		tf.format = RD::DATA_FORMAT_R32_UINT;
+		tf.texture_type = RD::TEXTURE_TYPE_3D;
+		tf.width = slots_x * BRICK_EDGE;
+		tf.height = slots_y * BRICK_EDGE;
+		tf.depth = slots_z * BRICK_EDGE;
+		// CAN_COPY_FROM is required for texture_get_data; without it the readback
+		// silently returns zero bytes.
+		tf.usage_bits = RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_SAMPLING_BIT |
+				RD::TEXTURE_USAGE_CAN_COPY_FROM_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
+		RID atlas = p_rd->texture_create(tf, RD::TextureView());
+
+		if (atlas.is_null()) {
+			result.error = "atlas texture creation failed";
+		} else {
+			const uint32_t pages = slots_x * slots_y * slots_z;
+			result.canary_texels = int(pages * VOXELS_PER_BRICK);
+
+			Vector<RD::Uniform> write_uniforms;
+			write_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 0, atlas));
+			RID write_set = p_rd->uniform_set_create(write_uniforms, canary_write_shader, 0);
+
+			CanaryPushConstants pc{};
+			pc.page_count = pages;
+			pc.page_slots_x = slots_x;
+			pc.page_slots_y = slots_y;
+			pc.offset = 0;
+
+			const uint32_t groups = groups_for(pages * VOXELS_PER_BRICK);
+
+			RD::ComputeListID cl = p_rd->compute_list_begin();
+			p_rd->compute_list_bind_compute_pipeline(cl, canary_write_pipeline);
+			p_rd->compute_list_bind_uniform_set(cl, write_set, 0);
+			p_rd->compute_list_set_push_constant(cl, &pc, sizeof(pc));
+			p_rd->compute_list_dispatch(cl, groups, 1, 1);
+			p_rd->compute_list_end();
+
+			// Verify by reading the atlas back and comparing on the CPU. This is
+			// stronger than a second kernel: it checks the texels that were actually
+			// written, and cannot be fooled by a check pass that silently no-ops.
+			Vector<uint8_t> texels = p_rd->texture_get_data(atlas, 0);
+			if (texels.size() < int64_t(pages) * VOXELS_PER_BRICK * 4) {
+				result.error = vformat("atlas readback short: %d bytes", int(texels.size()));
+				result.canary_mismatches = -1;
+			} else {
+				const uint32_t *t = reinterpret_cast<const uint32_t *>(texels.ptr());
+				int bad = 0;
+				for (uint32_t page = 0; page < pages; page++) {
+					for (uint32_t local_index = 0; local_index < VOXELS_PER_BRICK; local_index++) {
+						const uint32_t lx = local_index & 7u;
+						const uint32_t ly = (local_index >> 3) & 7u;
+						const uint32_t lz = (local_index >> 6) & 7u;
+						const uint32_t bx = page % slots_x;
+						const uint32_t by = (page / slots_x) % slots_y;
+						const uint32_t bz = page / (slots_x * slots_y);
+						const uint32_t x = bx * BRICK_EDGE + lx;
+						const uint32_t y = by * BRICK_EDGE + ly;
+						const uint32_t z = bz * BRICK_EDGE + lz;
+						const size_t offset = size_t(x) + size_t(y) * tf.width + size_t(z) * size_t(tf.width) * size_t(tf.height);
+						const uint32_t expected = (page << 9) | local_index;
+						if (t[offset] != expected) {
+							bad++;
+						}
+					}
+				}
+				result.canary_mismatches = bad;
+			}
+
+			p_rd->free_rid(write_set);
+			p_rd->free_rid(atlas);
+		}
+	}
+
+	// --- allocator: compaction, allocation, commit -------------------------
+	{
+		const uint32_t slot_count = 4096;
+		const uint32_t capacity = 256;
+		const uint32_t request_count = 300;
+
+		Vector<uint8_t> table_bytes;
+		table_bytes.resize(slot_count * PAGE_ENTRY_BYTES);
+		memset(table_bytes.ptrw(), 0, table_bytes.size());
+		{
+			uint32_t *p = reinterpret_cast<uint32_t *>(table_bytes.ptrw());
+			for (uint32_t i = 0; i < slot_count; i++) {
+				p[i * 4 + 0] = 0xFFFFFFFFu; // page_id = INVALID
+				p[i * 4 + 2] = 0; // UNMAPPED
+			}
+		}
+
+		Vector<uint8_t> free_bytes;
+		free_bytes.resize(capacity * 4);
+		{
+			uint32_t *p = reinterpret_cast<uint32_t *>(free_bytes.ptrw());
+			for (uint32_t i = 0; i < capacity; i++) {
+				p[i] = i;
+			}
+		}
+
+		const uint32_t word_count = (slot_count + 31) / 32;
+		Vector<uint8_t> request_bytes;
+		request_bytes.resize(word_count * 4);
+		memset(request_bytes.ptrw(), 0, request_bytes.size());
+		{
+			uint32_t *p = reinterpret_cast<uint32_t *>(request_bytes.ptrw());
+			for (uint32_t i = 0; i < request_count; i++) {
+				const uint32_t slot = 100 + i;
+				p[slot / 32] |= (1u << (slot % 32));
+			}
+		}
+
+		Vector<uint8_t> zeros_counters;
+		zeros_counters.resize(COUNTERS_BYTES);
+		Vector<uint8_t> zeros_cursor;
+		zeros_cursor.resize(4);
+		Vector<uint8_t> compacted_bytes;
+		compacted_bytes.resize(slot_count * 4);
+		Vector<uint8_t> allocated_bytes;
+		allocated_bytes.resize(capacity * 4);
+		Vector<uint8_t> meta_bytes;
+		meta_bytes.resize(capacity * BRICK_META_BYTES);
+
+		RID table_buf = p_rd->storage_buffer_create(uint32_t(table_bytes.size()), table_bytes);
+		RID meta_buf = p_rd->storage_buffer_create(uint32_t(meta_bytes.size()), meta_bytes);
+		RID free_buf = p_rd->storage_buffer_create(uint32_t(free_bytes.size()), free_bytes);
+		RID cursor_buf = p_rd->storage_buffer_create(4, zeros_cursor);
+		RID request_buf = p_rd->storage_buffer_create(uint32_t(request_bytes.size()), request_bytes);
+		RID compacted_buf = p_rd->storage_buffer_create(uint32_t(compacted_bytes.size()), compacted_bytes);
+		RID counters_buf = p_rd->storage_buffer_create(COUNTERS_BYTES, zeros_counters);
+		RID allocated_buf = p_rd->storage_buffer_create(uint32_t(allocated_bytes.size()), allocated_bytes);
+
+		Vector<RD::Uniform> uniforms;
+		uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_STORAGE_BUFFER, 0, table_buf));
+		uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_STORAGE_BUFFER, 1, meta_buf));
