+
+// Runs after the host has zeroed the page. INITIALIZING is the only path to
+// COMMITTED, so no reader can observe an uninitialised page.
+void initialize_one(uint cursor) {
+	uint slot = allocated_slots.slots[cursor];
+	uint page = table.entries[slot].page_id;
+	if (page == SB_INVALID_PAGE) {
+		return;
+	}
+	table.entries[slot].state = SB_STATE_COMMITTED;
+	metadata.meta[page].state = SB_STATE_COMMITTED;
+	metadata.meta[page].last_write_epoch = pc.epoch;
+	atomicAdd(counters.committed, 1u);
