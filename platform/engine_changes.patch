+	print_line(vformat("  formats: R32_UINT_3D=%s R8_UINT_3D=%s E5B9G9R9_view=%s storage_buffer=%s",
+			caps.r32_uint_3d_storage ? "yes" : "no", caps.r8_uint_3d_storage ? "yes" : "no",
+			caps.e5b9g9r9_shareable_view ? "yes" : "no", caps.storage_buffer ? "yes" : "no"));
+	if (plan.decision != hddagi_sparse::Decision::REFUSED) {
+		print_line(vformat("  plan: virtual_pages=%d capacity=%d slots=%dx%dx%d atlas_texels=%dx%dx%d total=%.2f MiB",
